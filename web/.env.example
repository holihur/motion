# Catch browser SDK (build-time; leave empty to disable).
# The ingest key is write-only and safe to expose in the bundle.
VITE_CATCH_URL=
VITE_CATCH_INGEST_KEY=
VITE_CATCH_ENV=production
VITE_CATCH_SERVICE=motion-web
VITE_CATCH_RELEASE=

# Zero-touch telemetry. pageview/click/submit/expose are collected without any
# business code; set to "none" to keep errors only (known: errors/logs always on).
VITE_CATCH_AUTO_TRACK=pageview,click,submit,expose
# Optional sampling for logs (errors are never sampled) and for tracking events.
VITE_CATCH_SAMPLE_RATE=1
VITE_CATCH_TRACK_SAMPLE_RATE=1
