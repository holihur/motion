# ---- Motion instance ----
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=motion
APP_NAME=Motion
SEED_DEMO=true
ALLOW_SIGNUP=true
MCP_ENABLED=true

# Bootstrap workspace administrators. Once you have saved settings in the Ops
# console, those settings override these values. Separate multiple emails with
# commas. This does NOT grant access to Ops.
ADMIN_EMAILS=

# Dedicated Ops console token. Ops is available at /ops and is completely
# separate from user accounts. Generate one with:
#   openssl rand -base64 32
# Leave empty to disable the Ops console.
OPS_TOKEN=

# Change these in production. ENCRYPTION_KEY protects BYOK keys and OIDC
# client secrets at rest; rotating it invalidates stored secrets.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Comma-separated allowed browser origins for development (Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ----
# Optional. Leave empty to use embedded assets or ./web/dist.
WEB_DIR=

# ---- AI / BYOK ----
# Default Gemini model for users who select the native Gemini provider.
AI_MODEL=gemini-flash-lite-latest

# ---- OIDC (optional bootstrap, editable in Ops) ----
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_NAME=Continue with single sign-on
OIDC_SCOPES=openid,email,profile
OIDC_ALLOWED_DOMAINS=
OIDC_AUTO_CREATE=true

# ---- Updates (editable in Ops) ----
UPDATE_REPO=holihur/motion
AUTO_UPDATE=off
UPDATE_INTERVAL_HOURS=24
# Optional GitHub token to avoid API rate limits.
GITHUB_TOKEN=
